# UK Work Visa Evidence Assistant - environment variables.
# Copy to .env and fill the blanks. .env is git/docker/zip-ignored. Never paste keys into chat.
# DEFAULT = safe offline demo: no keys, no cost, no model. Passages are shown word for word.
#
# IMPORTANT: filling a key does NOT switch anything on. Providers switch only when you change these settings:
#   Real answers:   LLM_PROVIDER=openai (or anthropic) + LLM_MODEL=<your model> + LLM_API_KEY=<key>
#   Real vectors:   EMBEDDING_PROVIDER=openai + EMBEDDING_MODEL=<model> + EMBEDDING_API_KEY=<key>,
#                   then run: python -m ingestion.embed --force
#   Use vectors:    RETRIEVAL_MODE=hybrid   (needs the real vectors file above)
#   Use Supabase:   STORE=supabase + SUPABASE_URL + SUPABASE_ANON_KEY (after running supabase/schema.sql and the upload)
# The app warns on /health and on the page if a key is filled but its provider is still off.
# Anthropic has no embeddings API: use an OpenAI-compatible embedding provider for vectors.

CORPUS_VERSION=2026-10-12-snapshot

# --- Storage / retrieval ---
STORE=local                     # local | supabase
RETRIEVAL_MODE=keyword          # keyword | hybrid  (hybrid needs real vectors, see README)
TOP_K=5

# --- Language model (answers). "fake" = offline demo, no model. Blank = passages only. ---
LLM_PROVIDER=fake               # fake | openai | anthropic
LLM_MODEL=                      # you choose, e.g. a model your account can use
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS_PARAM=max_completion_tokens
LLM_TEMPERATURE=
MAX_OUTPUT_TOKENS=1500

# --- Embeddings (separate provider/key from the language model) ---
EMBEDDING_PROVIDER=             # openai | fake | blank (blank is fine for keyword mode)
EMBEDDING_MODEL=                # e.g. text-embedding-3-small (1536 dims)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1536              # must equal vector(1536) in supabase/schema.sql

# --- Supabase (DEV project only until tested) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=              # used by the web app (read-only through RLS)
SUPABASE_SERVICE_ROLE_KEY=      # ingestion script only, your machine only, never in Docker
SUPABASE_FALLBACK_LOCAL=false   # true = allow local search if Supabase fails (shown in logs)

# --- Guardrails ---
STALE_DAYS=45
DAILY_TOKEN_BUDGET=200000
RATE_LIMIT_PER_MIN=10
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
